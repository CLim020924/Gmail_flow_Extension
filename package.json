{
  "name": "gmail-flow-desktop",
  "version": "0.5.3",
  "description": "사용자 정의 명단과 변수를 사용하는 Gmail 메일 자동화 Windows 앱",
  "main": "desktop/main.js",
  "author": "CLim020924",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "desktop": "electron .",
    "test": "node tests/oauth-login-hint.test.js && node tests/oauth-optional-secret.test.js && node tests/background-attachment.test.js",
    "build:windows": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.gmailflow.desktop",
    "productName": "Gmail Flow",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "background.js",
      "core.js",
      "popup.html",
      "popup.js",
      "styles.css",
      "desktop-shim.js",
      "desktop/**/*",
      "!desktop/oauth-credentials.local.js",
      "icons/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon-master.png"
    },
    "portable": {
      "artifactName": "Gmail-Flow-${version}-Windows.${ext}"
    },
    "nsis": {
      "artifactName": "Gmail-Flow-Setup-${version}-Windows.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gmail Flow",
      "deleteAppDataOnUninstall": false
    }
  }
}
