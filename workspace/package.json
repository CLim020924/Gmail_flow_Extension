{
  "name": "cmoe-workspace",
  "version": "1.1.13",
  "description": "명단, 일정, 계정과 업무 모듈을 프로젝트 단위로 관리하는 Windows Workspace",
  "main": "desktop/main.js",
  "author": "CLim020924",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix vendor ci --omit=dev",
    "desktop": "electron .",
    "test": "node tests/workspace-core.test.js && node tests/operations-core.test.js && node tests/spreadsheet.test.js && node tests/auth-manager.test.js && node tests/extension-core.test.js && node tests/mail-mime.test.js && node tests/state-merge.test.js && node tests/drive-sync-guard.test.js && node tests/transaction-queue.test.js && node tests/gmail-flow-host.test.js && node tests/external-commit.test.js && node ../tests/cloud-sync-revision.test.js && node ../tests/oauth-optional-secret.test.js && node ../tests/background-attachment.test.js && node ../tests/oauth-login-hint.test.js && node ../tests/desktop-storage.test.js",
    "smoke": "node scripts/run-smoke.js",
    "preflight:build": "node scripts/preflight-build.js",
    "prebuild:windows": "npm run preflight:build",
    "build:windows": "electron-builder --win portable --x64",
    "prebuild:installer": "npm run preflight:build",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.co.cmoe.workspace",
    "productName": "CMOE Workspace",
    "beforeBuild": "scripts/electron-builder-hooks.js",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "workspace-core.js",
      "operations-core.js",
      "extension-core.js",
      "app.js",
      "extensions/**/*",
      "examples/**/*",
      "vendor/package.json",
      "vendor/node_modules/**/*",
      "desktop/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/node_modules",
        "to": "vendor/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..",
        "to": "gmail-flow",
        "filter": [
          "background.js",
          "core.js",
          "popup.html",
          "popup.js",
          "styles.css",
          "desktop-shim.js",
          "desktop/preload.js",
          "desktop/storage.js",
          "desktop/oauth.js",
          "icons/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "CMOE-Workspace-${version}-Windows.${ext}"
    },
    "nsis": {
      "artifactName": "CMOE-Workspace-Setup-${version}-Windows.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CMOE Workspace",
      "deleteAppDataOnUninstall": false
    }
  }
}
